{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.19.3",
          "rules": [
            {
              "id": "py/sql-injection",
              "name": "py/sql-injection",
              "shortDescription": {"text": "SQL query built from user-controlled sources"},
              "defaultConfiguration": {"level": "error"},
              "properties": {
                "tags": ["security", "external/cwe/cwe-089"],
                "precision": "high",
                "security-severity": "8.8"
              }
            },
            {
              "id": "py/weak-sensitive-data-hashing",
              "name": "py/weak-sensitive-data-hashing",
              "shortDescription": {"text": "Use of a broken or weak cryptographic hashing algorithm on sensitive data"},
              "defaultConfiguration": {"level": "warning"},
              "properties": {
                "tags": ["security", "external/cwe/cwe-327", "external/cwe/cwe-328", "external/cwe/cwe-916"],
                "security-severity": "7.5"
              }
            }
          ]
        }
      },
      "versionControlProvenance": [
        {"repositoryUri": "https://github.com/acme/shop", "revisionId": "1111111111111111111111111111111111111111", "branch": "refs/heads/main"}
      ],
      "results": [
        {
          "ruleId": "py/sql-injection",
          "ruleIndex": 0,
          "level": "error",
          "message": {"text": "This SQL query depends on a [user-provided value](1)."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/db.py", "uriBaseId": "%SRCROOT%", "index": 0},
                "region": {"startLine": 12, "startColumn": 5, "endColumn": 60, "snippet": {"text": "    cur.execute(\"SELECT * FROM users WHERE name = '%s'\" % name)"}}
              }
            }
          ],
          "codeFlows": [
            {
              "threadFlows": [
                {
                  "locations": [
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "app/views.py"}, "region": {"startLine": 8}}, "message": {"text": "request.args"}}},
                    {"location": {"physicalLocation": {"artifactLocation": {"uri": "app/db.py"}, "region": {"startLine": 12}}, "message": {"text": "cur.execute"}}}
                  ]
                }
              ]
            }
          ],
          "partialFingerprints": {"primaryLocationLineHash": "abc123:1"}
        },
        {
          "ruleId": "py/weak-sensitive-data-hashing",
          "ruleIndex": 1,
          "message": {"text": "Sensitive data (password) is used in a hashing algorithm (MD5) that is insecure."},
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {"uri": "app/auth.py"},
                "region": {"startLine": 5}
              }
            }
          ]
        },
        {
          "ruleId": "py/sql-injection",
          "message": {"text": "suppressed one"},
          "suppressions": [{"kind": "inSource"}],
          "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/old.py"}, "region": {"startLine": 3}}}]
        }
      ]
    }
  ]
}
